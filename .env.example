# =====================================================
# COPY FILE NÀY THÀNH .env VÀ ĐIỀN GIÁ TRỊ THẬT
# cp .env.example .env
# File .env KHÔNG được commit lên Git
# =====================================================

# Database
DB_URL=jdbc:postgresql://localhost:5432/cgv
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# Keycloak
CLIENT_ID=CGV_App
CLIENT_SERECT=CHANGE_ME
REALM=cgv-realm
KEYCLOAK_URL=http://localhost:8180

# Kafka
KAFKA_BOOTSTRAP_SERVERS=cgv-kafka-1:19092,cgv-kafka-2:19092,cgv-kafka-3:19092

# Email (Brevo SMTP)
BREVO_API_KEY=CHANGE_ME
EMAIL=your-email@gmail.com
EXPIRY_TIME=5

# Production only
# KEYCLOAK_CLIENT_SECRET=CHANGE_ME
# FRONTEND_URL=https://your-domain.com
