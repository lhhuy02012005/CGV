  "regionId": {{regionId}},
  "name": "CineGo HTTP Cinema B {{$timestamp}}",
  "address": "100 Nguyen Hue, District 1",
  "phone": "02812345679",
  "openingHours": "09:00 - 23:00",
  "status": "ACTIVE"
}

> {%
