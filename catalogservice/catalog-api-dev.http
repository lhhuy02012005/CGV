  "surcharge": 0,
  "description": "Ghế thường"
}


### 4.2 Create VIP SeatType
POST {{baseUrl}}/seat-types
Content-Type: application/json

{
  "name": "VIP",
  "surcharge": 15000,
  "description": "Ghế VIP"
}


### 4.3 Get all SeatTypes
