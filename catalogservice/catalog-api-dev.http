Content-Type: application/json

{
  "locationName": "HTTP Test Cinema - Hall",
  "maxAttendees": 120
}


### 12.5 Update Event status -> ONGOING
PATCH {{baseUrl}}/events/{{eventId}}/status
Content-Type: application/json

{
  "status": "ONGOING"
}


### 12.6 Restore Event status -> UPCOMING
PATCH {{baseUrl}}/events/{{eventId}}/status
Content-Type: application/json

{
  "status": "UPCOMING"
}


### ============================================================
### 13. SHOWTIME
### Depends on Movie + Room + existing active Seats.
### Run this AFTER Seat mutation tests because scheduled showtimes lock seat changes.
### ============================================================

### 13.1 Create Showtime
POST {{baseUrl}}/showtimes
Content-Type: application/json

{
  "movieId": "{{movieId}}",
  "roomId": "{{roomId}}",
  "showDate": "2030-01-15",
  "startTime": "2030-01-15T19:00:00",
  "endTime": "2030-01-15T21:30:00",
  "language": "English",
  "subtitleLanguage": "Vietnamese",
  "format": "IMAX",
  "basePrice": 120000,
  "status": "SCHEDULED"
}

> {%
client.global.set("showtimeId", String(response.body["data"]["id"]));
%}


### 13.2 Get Showtime by ID
GET {{baseUrl}}/showtimes/{{showtimeId}}
Accept: application/json


### 13.3 Showtime by Cinema + date
### This is the API shape useful for "Lịch chiếu theo rạp".
GET {{baseUrl}}/showtimes?cinemaId={{cinemaId}}&showDate=2030-01-15&page={{page}}&size={{size}}
Accept: application/json


### 13.4 Showtime by Movie + Format + available seats
GET {{baseUrl}}/showtimes?movieId={{movieId}}&format=IMAX&available=true&page={{page}}&size={{size}}
Accept: application/json


### 13.5 Showtime by date/time/price range
GET {{baseUrl}}/showtimes?showDateFrom=2030-01-01&showDateTo=2030-01-31&startTimeFrom=2030-01-15T00:00:00&startTimeTo=2030-01-15T23:59:59&minPrice=100000&maxPrice=200000&page={{page}}&size={{size}}
Accept: application/json


### 13.6 Update Showtime
PATCH {{baseUrl}}/showtimes/{{showtimeId}}
Content-Type: application/json

{
  "basePrice": 130000,
  "subtitleLanguage": "Vietnamese"
}


### 13.7 Cancel Showtime
PATCH {{baseUrl}}/showtimes/{{showtimeId}}/status
Content-Type: application/json

{
  "status": "CANCELLED"
}


### 13.8 Restore Showtime -> SCHEDULED
PATCH {{baseUrl}}/showtimes/{{showtimeId}}/status
Content-Type: application/json

{
  "status": "SCHEDULED"
}


### ============================================================
### 14. BUSINESS-RULE / NEGATIVE TESTS
### ============================================================

### 14.1 EXPECT 409:
### Cannot modify Seat while its Room has a future SCHEDULED Showtime.
PATCH {{baseUrl}}/seats/{{seatId}}/status
Content-Type: application/json

{
  "isActive": false
}


### 14.2 EXPECT 409:
### VIP is referenced by Seat A1/A2, therefore SeatType deletion must be blocked.
DELETE {{baseUrl}}/seat-types/VIP


### 14.3 EXPECT 400:
### Invalid Showtime: endTime is before startTime.
POST {{baseUrl}}/showtimes
Content-Type: application/json

{
  "movieId": "{{movieId}}",
  "roomId": "{{roomId}}",
  "showDate": "2030-01-16",
  "startTime": "2030-01-16T21:00:00",
  "endTime": "2030-01-16T19:00:00",
  "language": "English",
  "subtitleLanguage": "Vietnamese",
  "format": "IMAX",
  "basePrice": 120000,
  "status": "SCHEDULED"
}


### ============================================================
### 15. DELETE-ENDPOINT TESTS / CLEANUP
### Only endpoints actually exposed by the current controllers.
### Do NOT run cleanup until you finish the tests above.
### ============================================================

### 15.1 Delete Article
DELETE {{baseUrl}}/articles/{{articleId}}


### 15.2 Delete MovieCast
DELETE {{baseUrl}}/movie-casts/{{movieCastId}}


### 15.3 Delete MovieGenre relation
DELETE {{baseUrl}}/movie-genres/{{movieId}}/{{genreId}}


### 15.4 Delete Cinema Amenity relation - IMAX
DELETE {{baseUrl}}/cinema-amenities/{{cinemaId}}/IMAX


### 15.5 Create independent temporary Genre for successful DELETE test
POST {{baseUrl}}/genres
Content-Type: application/json

{
  "name": "HTTP Delete Genre {{$timestamp}}",
  "slug": "http-delete-genre-{{$timestamp}}"
}

> {%
client.global.set("tempGenreId", String(response.body["data"]["id"]));
%}


### 15.6 Delete independent Genre
DELETE {{baseUrl}}/genres/{{tempGenreId}}


### 15.7 Create independent temporary Region for successful DELETE test
POST {{baseUrl}}/regions
Content-Type: application/json

{
  "name": "HTTP Delete Region {{$timestamp}}",
  "slug": "http-delete-region-{{$timestamp}}"
}

> {%
client.global.set("tempRegionId", String(response.body["data"]["id"]));
%}


### 15.8 Delete independent Region
DELETE {{baseUrl}}/regions/{{tempRegionId}}


