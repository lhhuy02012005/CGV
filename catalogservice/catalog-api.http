  "status": "CANCELLED"
}


### 13.8 Restore Showtime -> SCHEDULED
PATCH {{baseUrl}}/showtimes/{{showtimeId}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "SCHEDULED"
}


### ============================================================
### 14. BUSINESS-RULE / NEGATIVE TESTS
### ============================================================

### 14.1 EXPECT 409:
### Cannot modify Seat while its Room has a future SCHEDULED Showtime.
PATCH {{baseUrl}}/seats/{{seatId}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "isActive": false
}

> {%
client.test("Seat change blocked by scheduled Showtime -> 409", function () {
    client.assert(response.status === 409, "Expected HTTP 409");
});
%}


### 14.2 EXPECT 409:
### VIP is referenced by Seat A1/A2, therefore SeatType deletion must be blocked.
DELETE {{baseUrl}}/seat-types/VIP
Authorization: Bearer {{token}}

> {%
client.test("Referenced SeatType deletion blocked -> 409", function () {
    client.assert(response.status === 409, "Expected HTTP 409");
});
%}


### 14.3 EXPECT 400:
### Invalid Showtime: endTime is before startTime.
POST {{baseUrl}}/showtimes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "movieId": "{{movieId}}",
  "roomId": "{{roomId}}",
  "showDate": "2030-01-16",
  "startTime": "2030-01-16T21:00:00",
  "endTime": "2030-01-16T19:00:00",
  "language": "English",
  "subtitleLanguage": "Vietnamese",
  "format": "IMAX",
  "basePrice": 120000,
  "status": "SCHEDULED"
}

> {%
client.test("Invalid Showtime time -> 400", function () {
    client.assert(response.status === 400, "Expected HTTP 400");
});
%}


