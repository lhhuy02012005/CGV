{
  "analysis": {
    "filter": {
      "edge_ngram_filter": {
        "type": "edge_ngram",
        "min_gram": 2,
        "max_gram": 20
      },
      "ascii_folding_filter": {
        "type": "asciifolding",
        "preserve_original": true
      }
    },
    "analyzer": {
      "vietnamese_search_analyzer": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": [
          "lowercase",
          "ascii_folding_filter"
        ]
      },
      "autocomplete_analyzer": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": [
          "lowercase",
          "ascii_folding_filter",
          "edge_ngram_filter"
        ]
      }
    }
  }
}